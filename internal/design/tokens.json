{
  "$description": "Design tokens — W3C DTCG format (https://tr.designtokens.org/format/). Two-layer system: `palette` holds raw color ramps (the vocabulary); `color` holds semantic roles (the grammar) that reference palette steps via `{palette.path.step}`. When you change a value here, also update the inline @theme block in design/elements.html, components.html, and sections.html.",

  "palette": {
    "$description": "Raw color ramps (50 = lightest, 950 = darkest). Components should not consume these directly — use semantic tokens under `color`. Reach into the palette only for charts, custom tints, or one-offs that don't justify a new semantic token.",
    "violet": {
      "50":  { "$value": "#f4f1ff", "$type": "color" },
      "100": { "$value": "#e9e0ff", "$type": "color" },
      "200": { "$value": "#d6c5ff", "$type": "color" },
      "300": { "$value": "#b8a0ff", "$type": "color" },
      "400": { "$value": "#9c7eff", "$type": "color" },
      "500": { "$value": "#7c5cff", "$type": "color" },
      "600": { "$value": "#6a4cf0", "$type": "color" },
      "700": { "$value": "#5639d0", "$type": "color" },
      "800": { "$value": "#422aa3", "$type": "color" },
      "900": { "$value": "#2f1e75", "$type": "color" },
      "950": { "$value": "#1a0f45", "$type": "color" }
    },
    "teal": {
      "50":  { "$value": "#f0fdfa", "$type": "color" },
      "100": { "$value": "#ccfbf1", "$type": "color" },
      "200": { "$value": "#99f6e4", "$type": "color" },
      "300": { "$value": "#5eead4", "$type": "color" },
      "400": { "$value": "#2dd4bf", "$type": "color" },
      "500": { "$value": "#14b8a6", "$type": "color" },
      "600": { "$value": "#0d9488", "$type": "color" },
      "700": { "$value": "#0f766e", "$type": "color" },
      "800": { "$value": "#115e59", "$type": "color" },
      "900": { "$value": "#134e4a", "$type": "color" },
      "950": { "$value": "#042f2e", "$type": "color" }
    },
    "amber": {
      "50":  { "$value": "#fffbeb", "$type": "color" },
      "100": { "$value": "#fef3c7", "$type": "color" },
      "200": { "$value": "#fde68a", "$type": "color" },
      "300": { "$value": "#fcd34d", "$type": "color" },
      "400": { "$value": "#fbbf24", "$type": "color" },
      "500": { "$value": "#f59e0b", "$type": "color" },
      "600": { "$value": "#d97706", "$type": "color" },
      "700": { "$value": "#b45309", "$type": "color" },
      "800": { "$value": "#92400e", "$type": "color" },
      "900": { "$value": "#78350f", "$type": "color" },
      "950": { "$value": "#451a03", "$type": "color" }
    }
  },

  "color": {
    "$description": "Semantic color roles. Components consume these. Each value references a palette step so a single hue change propagates everywhere.",
    "bg":               { "$value": "#0b0d10", "$type": "color" },
    "surface":          { "$value": "#16181d", "$type": "color" },
    "surface-elevated": { "$value": "#1d2026", "$type": "color" },
    "fg":               { "$value": "#e8eaed", "$type": "color" },
    "fg-muted":         { "$value": "#9aa0a6", "$type": "color" },
    "fg-inverse":       { "$value": "#0b0d10", "$type": "color" },

    "primary":          { "$value": "{palette.violet.500}", "$type": "color" },
    "primary-hover":    { "$value": "{palette.violet.600}", "$type": "color" },
    "secondary":        { "$value": "{palette.teal.500}",   "$type": "color" },
    "secondary-hover":  { "$value": "{palette.teal.600}",   "$type": "color" },
    "tertiary":         { "$value": "{palette.amber.500}",  "$type": "color" },
    "tertiary-hover":   { "$value": "{palette.amber.600}",  "$type": "color" },

    "accent":           { "$value": "#22d3ee", "$type": "color" },
    "border":           { "$value": "#2a2e36", "$type": "color" },
    "success":          { "$value": "#22c55e", "$type": "color" },
    "warning":          { "$value": "#f59e0b", "$type": "color" },
    "danger":           { "$value": "#ef4444", "$type": "color" },
    "info":             { "$value": "#3b82f6", "$type": "color" }
  },

  "space": {
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "24px", "$type": "dimension" },
    "6": { "$value": "32px", "$type": "dimension" },
    "7": { "$value": "48px", "$type": "dimension" },
    "8": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "font": {
    "family": {
      "display": { "$value": "Inter, ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "Inter, ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "JetBrains Mono, ui-monospace, SFMono-Regular, monospace", "$type": "fontFamily" }
    },
    "size": {
      "xs":  { "$value": "12px", "$type": "dimension" },
      "sm":  { "$value": "14px", "$type": "dimension" },
      "md":  { "$value": "16px", "$type": "dimension" },
      "lg":  { "$value": "18px", "$type": "dimension" },
      "xl":  { "$value": "24px", "$type": "dimension" },
      "2xl": { "$value": "32px", "$type": "dimension" },
      "3xl": { "$value": "48px", "$type": "dimension" },
      "4xl": { "$value": "64px", "$type": "dimension" }
    },
    "weight": {
      "regular":  { "$value": "400", "$type": "fontWeight" },
      "medium":   { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold":     { "$value": "700", "$type": "fontWeight" }
    }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(0,0,0,0.4)",   "$type": "shadow" },
    "md": { "$value": "0 4px 12px rgba(0,0,0,0.5)",  "$type": "shadow" },
    "lg": { "$value": "0 12px 32px rgba(0,0,0,0.6)", "$type": "shadow" }
  },
  "motion": {
    "ease": {
      "standard":   { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0.2, 1)",     "$type": "cubicBezier" },
      "accelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)",     "$type": "cubicBezier" }
    },
    "duration": {
      "fast":    { "$value": "120ms", "$type": "duration" },
      "default": { "$value": "200ms", "$type": "duration" },
      "slow":    { "$value": "360ms", "$type": "duration" }
    }
  }
}
